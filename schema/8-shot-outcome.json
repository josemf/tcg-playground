{
    "$id": "https://tennistcg.io/schema/8-shot-outcome.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Phase 6 — Resolve shot outcome",
    "type": "object",
    "required": [
        "context",
        "players",
        "phase"
    ],
    "properties": {
        "context": {
            "$ref": "https://tennistcg.io/schema/state-context.json"
        },
        "players": {
            "type": "object",
            "properties": {
                "playerA": {
                    "$ref": "https://tennistcg.io/schema/state-player.json"
                },
                "playerB": {
                    "$ref": "https://tennistcg.io/schema/state-player.json"
                }
            },
            "required": [
                "playerA",
                "playerB"
            ]
        },
        "phase": {
            "type": "object",
            "required": [
                "type",
                "effectiveRSQ",
                "pointDecideOutcome",
                "positioning",
                "resultingSQ"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "resolve-shot-outcome"
                },
                "selectedShot": {
                    "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/shotCard"
                },
                "effectiveRSQ": {
                    "type": "integer",
                    "description": "The effective RSQ from previous phase"
                },
                "pointDecideOutcome": {
                    "type": "object",
                    "properties": {
                        "decidePoint": {
                            "type": "string",
                            "description": "The point is decided if any winner or error conditions are matched",
                            "enum": ["winner", "error", "point_continues"]
                        },
                        "matchedRule": {
                            "type": "string",
                            "description": "The rule that matches effective RSQ to decide the point. When there isn't a shot card that defines winner or error rule, the following are used: - Winner: EffectiveRSQ ≥ 2×incoming SQ and EffectiveRSQ < 15 → you win the point. Error: EffectiveRSQ ≤ incoming SQ/2 → you lose the point.- Error: EffectiveRSQ > 15 → you lose the point."
                        },
                        "sourceCard": {
                            "type": "string",
                            "description": "The card name that contains the rule used to decide the point"
                        }
                    },
                    "required": ["decidePoint"]
                },
                "positioning": {
                    "type": "object",
                    "required": ["action", "staminaSpent", "finalPosition"],
                    "properties": {
                        "cardOverridesPositioningDecision": {
                            "type": "object",
                            "description": "Some cards have the effect to decide the player positioning in court",
                            "properties": {
                                "sourceCard": {
                                    "type": "string",
                                    "description": "The card name that decided the player positioning in the court"
                                },
                                "position": {
                                    "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/courtPosition",
                                    "description": "When a card decided the player positioning this should reflect the new player position according to the card"
                                }
                            }
                        },
                        "action": {
                            "type": "string",
                            "description": "The hitting player can decide to approach the net or move to the baseline",
                            "enum": ["approach_the_net", "move_baseline", "keep_position"]
                        },
                        "staminaSpent": {
                            "type": "object",                   
                            "properties": {
                                "amount": {
                                    "description": "Stamina spent to move position after shot.",                            
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "remaining": {
                                    "description": "How much stamina remains for player",                            
                                    "type": "integer",
                                    "minimum": 0
                                }
                            },
                            "required": [
                                "amount",
                                "remaining"
                            ]
                        },                        
                        "finalPosition": {                            
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/courtPosition",
                            "description": "The final hitting player position"
                        }
                    }
                },

                "resultingSQ": {
                    "type": "object",
                    "description": "After effective RSQ we calculate the player SQ to take into account court conditions or other environmental factors that change ball movement",
                    "required": ["speedModifier", "value"],
                    "properties": {
                        "speedModifier": {
                            "type": "integer",
                            "description": "Court speed modifier according the court surface. Default is 0."
                        },
                        "value": {
                            "type": "integer",
                            "description": "Next incoming SQ on opponent turn"
                        }
                    }
                }
            }
        },

        "additionalProperties": false
    }
}
