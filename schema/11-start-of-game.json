{
    "$id": "https://tennistcg.io/schema/11-start-of-game.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PH1 — Start of Game",
    "type": "object",
    "required": [
        "context",
        "players",
        "phase"
    ],
    "properties": {
        "context": {
            "$ref": "https://tennistcg.io/schema/state-context.json"
        },
        "players": {
            "type": "object",
            "properties": {
                "playerA": {
                    "$ref": "https://tennistcg.io/schema/state-player.json"
                },
                "playerB": {
                    "$ref": "https://tennistcg.io/schema/state-player.json"
                }
            },
            "required": [
                "playerA",
                "playerB"
            ]
        },
        "phase": {
            "type": "object",
            "required": [
                "type",
                "cardCycle",
                "staminaRecovery"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "start-point"
                },
                "cardCycle": {
                    "type": "object",
                    "required": [
                        "cycled",
                        "discarded",
                        "drawn"
                    ],
                    "properties": {
                        "cycled": {
                            "type": "boolean"
                        },
                        "discarded": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "Name/id of the card discarded from hand when cycling; null if no cycle."                            
                        },
                        "drawn": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "Name/id of the drawn card"
                        }
                    }
                },
                "staminaRecovery": {
                    "type": "object",
                    "description": "Replenishes stamina to max stamina",
                    "properties": {
                        "previousStamina": {
                            "type": "integer",
                            "description": "Stamina before applying recovery."                            
                        },
                        "staminaAfter": {
                            "type": "integer",
                            "description": "Stamina after applying recovery (capped at maximum)."
                        }
                    },
                    "required": ["recoveryRate","previousStamina","staminaAfter"]                    
                }
            }
        }
    }
}
