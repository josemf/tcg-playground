{
    "$id": "https://tennistcg.io/schema/3-anticipate.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Phase 3 — Anticipate",
    "type": "object",
    "required": [
        "context",
        "players",
        "phase"
    ],
    "properties": {
        "context": {
            "$ref": "https://tennistcg.io/schema/state-context.json"
        },
        "players": {
            "type": "object",
            "properties": {
                "playerA": {
                    "$ref": "https://tennistcg.io/schema/state-player.json"
                },
                "playerB": {
                    "$ref": "https://tennistcg.io/schema/state-player.json"
                }
            },
            "required": [
                "playerA",
                "playerB"
            ]
        },
        "phase": {
            "type": "object",
            "required": [
                "type",
                "incomingSQ",
                "calculatedSQ",
                "effectiveSQ"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "anticipate"
                },
                "incomingSQ": {
                    "type": "integer",
                    "minimum": 0
                },
                "requiredPositioning": {
                    "type": "object",
                    "description": "In order to be able to continue the rally the player will be given the chance to approach the net or move the the baseline. This choice only applies when an opponent shot card defines it.",
                    "properties": {
                        "cardRequiresPositioning": {
                            "type": "object",
                            "description": "Some shot cards have the effect of requiring the player positioning in court when responding to a shot",
                            "properties": {
                                "sourceCard": {
                                    "type": "string",
                                    "description": "The card name that decided the player positioning in the court"
                                },
                                "position": {
                                    "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/courtPosition",
                                    "description": "The player positioning required by the card"
                                }
                            },
                            "required": ["sourceCard", "position"]
                        },
                        "action": {
                            "type": "string",
                            "description": "The player can decide to approach the net or move to the baseline as required by the opponent shot card",
                            "enum": ["approach_the_net", "move_baseline", "keep_position"]
                        },
                        "staminaSpent": {
                            "type": "object",                   
                            "properties": {
                                "amount": {
                                    "description": "How much spend stamina to up move on the court",                            
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "remaining": {
                                    "description": "How much stamina remains for player",                            
                                    "type": "integer",
                                    "minimum": 0
                                }
                            },
                            "required": [
                                "amount",
                                "remaining"
                            ]
                        },                        
                        "finalPosition": {                            
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/courtPosition",
                            "description": "The final hitting player position"
                        }                        
                    }
                },
                
                "calculatedSQ": {
                    "description": "The rule is to use agility and any spent stamina to calculate incoming SQ",
                    "type": "object",
                    "properties": {
                        "agility": {
                            "type": "integer"
                        },
                        "absorb" :{
                            "type": "integer",
                            "description": "The current amount from the player absorb modifier"
                        },
                        "staminaSpent": {
                            "type": "integer",
                            "description": "Stamina spent to reduce incoming SQ.",
                            "minimum": 0
                        },
                        "value": {
                            "type": "number",
                            "description": "Calculated SQ amount. That will be the effective SQ or subject to threshold 10 rule if the player is at the net"
                        }
                    },
                    "required": [
                        "agility",
                        "absorb",
                        "staminaSpent",
                        "value"
                    ]
                },
                "effectiveSQ": {
                    "description": "The effective SQ the responde player will face",
                    "type": "object",
                    "properties": {
                        "atTheNetThreshold10Rule": {
                            "description": "Wether the responder is at the net and we had to apply the threshold 10 rule: If incoming SQ < 10: New SQ = Calculated SQ − (10 − SQ); If incoming SQ = 10: New SQ = 10 (no change); If incoming SQ > 10: New SQ = Calculated SQ + (Calculated SQ − 10)",
                            "type": "boolean"
                        },
                        "value": {
                            "description": "Calculated SQ or New SQ after threshold 10 rule if responder at the net",
                            "type": "integer",
                            "minimum": 0                            
                        }
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
