{
    "$id": "https://tennistcg.io/schema/state-player.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Player State Object",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "baseStats": {
            "type": "object",
            "properties": {
                "serve": {
                    "type": "integer"
                },
                "forehand": {
                    "type": "integer"
                },
                "backhand": {
                    "type": "integer"
                },
                "agility": {
                    "type": "integer"
                },
                "stamina": {
                    "type": "integer"
                },
                "mental": {
                    "type": "integer"
                },
                "sp": {
                    "type": "integer"
                }
            },
            "required": [
                "serve",
                "forehand",
                "backhand",
                "agility",
                "stamina",
                "mental",
                "sp"
            ]
        },
        "effectiveStats": {
            "type": "object",
            "properties": {
                "serve": {
                    "type": "integer"
                },
                "forehand": {
                    "type": "integer"
                },
                "backhand": {
                    "type": "integer"
                },
                "agility": {
                    "type": "integer"
                },
                "mental": {
                    "type": "integer"
                },
                "staminaMax": {
                    "type": "integer"
                },
                "spMax": {
                    "type": "integer"
                }
            },
            "required": [
                "serve",
                "forehand",
                "backhand",
                "agility",
                "mental",
                "staminaMax",
                "spMax"
            ]
        },
        "currentStats": {
            "type": "object",
            "properties": {
                "stamina": {
                    "type": "integer"
                },
                "sp": {
                    "type": "integer"
                }
            },
            "required": [
                "stamina",
                "sp"
            ]
        },
        "modifiers": {
            "type": "object",
            "properties": {
                "pressure": {
                    "type": "integer",
                    "description": "Pressure can be attributed from other player active effects and have an impact how the player RSQ is calculated"
                },
                "adrenaline": {
                    "type": "integer",
                    "description": "Adrenaline will add or substract in full to RSQ, can make ball striking more powerful but might also have umpredictable effects"
                },
                "staminaRecoveryRate": {
                    "type": "integer",
                    "description": "How much stamina will be recovered between games"
                },
                "absorb": {
                    "type": "integer",
                    "description": "Absorb points are used at antecipation phase to absorb the opponent SP"
                }
            },
            "required": [
                "pressure",
                "adrenaline",
                "staminaRecoveryRate",
                "absorb"
            ]
        },
        "effects": {
            "type": "array",
            "items": {
                "$ref": "https://tennistcg.io/schema/state-effects.json"
            }
        },
        "equipment": {
            "type": "object",
            "properties": {
                "Racquet": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/equipmentCard"
                        }
                    ]
                },
                "Shoes": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/equipmentCard"
                        }
                    ]
                },
                "Wristband": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/equipmentCard"
                        }
                    ]
                },
                "Visor": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/equipmentCard"
                        }
                    ]
                },
                "Shirt": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/equipmentCard"
                        }
                    ]
                },
                "Shorts": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/equipmentCard"
                        }
                    ]
                },
                "Headband": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/equipmentCard"
                        }
                    ]
                },
                "Socks": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/equipmentCard"
                        }
                    ]
                },
                "Overgrip": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/equipmentCard"
                        }
                    ]
                }
            },
            "required": [
                "Racquet",
                "Shoes",
                "Wristband",
                "Visor",
                "Shirt",
                "Shorts",
                "Headband",
                "Socks",
                "Overgrip"
            ]
        },
        "position": {
            "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/courtPosition"
        },
        "hand": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 5,
            "maxItems": 5
        },
        "deckCount": {
            "type": "integer"
        },
        "discard": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "lastTurnShotCard": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "https://tennistcg.io/schema/definitions.json#/$defs/shotCard"
                }
            ]
        }
    },
    "required": [
        "name",
        "baseStats",
        "effectiveStats",
        "currentStats",
        "modifiers",
        "effects",
        "equipment",
        "position",
        "hand",
        "deckCount",
        "discard"
    ],
    "additionalProperties": false
}
