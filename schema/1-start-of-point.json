{
    "$id": "https://tennistcg.io/schema/1-start-of-point.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PH1 — Start of Point",
    "type": "object",
    "required": [
        "context",
        "players",
        "phase"
    ],
    "properties": {
        "context": {
            "$ref": "https://tennistcg.io/schema/state-context.json"
        },
        "players": {
            "type": "object",
            "properties": {
                "playerA": {
                    "$ref": "https://tennistcg.io/schema/state-player.json"
                },
                "playerB": {
                    "$ref": "https://tennistcg.io/schema/state-player.json"
                }
            },
            "required": [
                "playerA",
                "playerB"
            ]
        },
        "phase": {
            "type": "object",
            "required": [
                "type",
                "cardCycle"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "const": "start-point"
                },
                "cardCycle": {
                    "type": "object",
                    "required": [
                        "cycled",
                        "discarded",
                        "drawn"
                    ],
                    "properties": {
                        "cycled": {
                            "type": "boolean"
                        },
                        "discarded": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "Name/id of the card discarded from hand when cycling; null if no cycle."                            
                        },
                        "drawn": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "minimum": 0,
                            "description": "Number of cards drawn as part of the start-of-point cycle (normally 0 or 1)."                            
                        }
                    }
                },
                "staminaRecovery": {
                    "type": "object",
                    "properties": {
                        "recoveryRate": {
                            "type": "integer",
                            "description": "This is taken from the player stamina recovery rate modifier. This amount is added to the player stamina up to staminaMax"
                        },
                        "previousStamina": {
                            "type": "integer",
                            "description": "Stamina before applying recovery."                            
                        },
                        "staminaAfter": {
                            "type": "integer",
                            "description": "Stamina after applying recovery (capped at maximum)."
                        }
                    },
                    "required": ["recoveryRate","previousStamina","staminaAfter"]                    
                }
            }
        }
    }
}
